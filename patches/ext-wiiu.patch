+   return data.signalled ? ETIMEDOUT : 0;
+}
+
+int __libc_cond_wait(_COND_T *cond, _LOCK_T *lock, uint64_t timeout_ns)
+{
+   OSCondition *c = cond_object(cond);
+   OSMutex *m = lock_object(lock);
+
+   if (!c || !m)
+      return ENOMEM;
+
+   int64_t ticks = timeout_ns ? (int64_t)ns_to_ticks(timeout_ns) : 0;
+   return coreinit_cond_wait(c, m, ticks);
+}
+
+int __libc_cond_wait_recursive(_COND_T *cond, _LOCK_RECURSIVE_T *lock, uint64_t timeout_ns)
+{
+   wup_recursive_lock *rlock = (wup_recursive_lock *)lock;
+   wup_mutex_impl *impl = (wup_mutex_impl *)(uintptr_t)rlock->lock;
+
+   if (!impl)
+      return EINVAL;
+
+   int64_t ticks = timeout_ns ? (int64_t)ns_to_ticks(timeout_ns) : 0;
+   return coreinit_cond_wait(cond_object(cond), &impl->mutex, ticks);
+}
